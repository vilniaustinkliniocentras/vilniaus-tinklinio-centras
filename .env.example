# Supabase – public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase – server only (NEVER expose to browser or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin – temporary local dev protection only
ADMIN_PASSWORD=your-secure-dev-password

# Resend – server only (NEVER expose to browser)
RESEND_API_KEY=re_your_resend_api_key

# Contract email testing – server only (optional)
# When set, contract emails are sent to this address instead of parent_email.
# Remove or leave empty in production.
CONTRACT_EMAIL_OVERRIDE=
